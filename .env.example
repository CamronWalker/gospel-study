# xAI Grok API key (for conference_ai.py AI summaries)
XAI_API_KEY=your-xai-api-key-here

# YouTube Data API v3 key (for exact YouTube video links via playlist lookup)
# Get one at: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in your project
# NOTE: Only playlist lookups are used (~3 API calls per conference) to conserve quota.
# Without this key, YouTube search URLs are generated as fallback (no quota cost).
YOUTUBE_API_KEY=your-youtube-api-key-here
